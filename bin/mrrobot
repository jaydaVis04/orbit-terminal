#!/usr/bin/env python3
"""Enter the offline x86 Linux CTF lab, or transfer files over its local SSH link."""

import argparse
import base64
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path, PurePosixPath
import re
import secrets
import shlex
import shutil
import signal
import socket
import struct
import subprocess
import sys
import termios
import threading
import time
import zlib

ROOT = Path(os.environ.get("MRROBOT_HOME", Path.home() / ".local/share/mrrobot")).expanduser().resolve()
RUN = ROOT / "run"
STATE = ROOT / "state.json"
DISPLAY_LOCK = threading.RLock()


def preferences():
    path = ROOT / "settings.json"
    return json.loads(path.read_text()) if path.exists() else {}


class BootScreen:
    """An indeterminate boot display: stages come from QEMU and guest readiness."""

    stages = ("Check offline system", "Create temporary workspace", "Start x86 emulator",
              "Boot Linux kernel", "Start guest services", "Connect secure shell")

    def __init__(self, online=False):
        self.online = online
        self.enabled = sys.stdout.isatty() and os.environ.get("TERM") != "dumb"
        self.started = time.monotonic()
        self.stage = 0
        self.message = "Preparing your terminal"
        self.halt = threading.Event()
        self.thread = None
        self.finished = False

    def __enter__(self):
        if self.enabled:
            emit("\033[?1049h\033[?25l\033[2J\033[H", passthrough=False)
            self.thread = threading.Thread(target=self.animate, daemon=True)
            self.thread.start()
        return self

    def update(self, stage, message):
        self.stage = max(self.stage, stage)
        self.message = message
        if not self.enabled:
            print("MRROBOT / " + message, flush=True)

    def console(self):
        try:
            data = (RUN / "console.log").read_bytes()[-100000:].decode(errors="replace")
        except OSError:
            return
        data = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", data)
        if "Linux version" in data or "Booting Linux" in data:
            if self.stage < 4:
                self.update(4, "Linux kernel is running")
        if "OpenBSD Secure Shell server" in data or "Reached target multi-user.target" in data:
            if self.stage < 5:
                self.update(5, "Guest services are starting; waiting for SSH")

    def animate(self):
        while not self.halt.is_set():
            self.draw()
            self.halt.wait(0.1)

    def draw(self):
        columns, rows = shutil.get_terminal_size((100, 30))
        width = max(18, min(48, int(columns * 0.57) - 5))
        top = max(2, min(5, rows - 18))
        left = 4 if columns > 60 else 2
        elapsed = time.monotonic() - self.started
        spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"[int(elapsed * 10) % 10]
        red, white, muted, reset = "\033[38;2;255;51;79m", "\033[38;2;244;223;226m", "\033[38;2;149;96;108m", "\033[0m"
        lines = [muted + "F S O C I E T Y   /   LOCAL SYSTEMS", red + "\033[1mMR. ROBOT", white + "x86 binary analysis environment", "", red + "─" * width, ""]
        for index, label in enumerate(self.stages, 1):
            complete = self.stage > index or self.stage == 6
            icon = "✓" if complete else spinner if self.stage == index else "·"
            color = white if complete else red if self.stage == index else muted
            lines.append(color + icon + "  " + label)
        travel = max(4, width - 7)
        position = int(elapsed * 8) % (travel * 2)
        position = position if position < travel else travel * 2 - position - 1
        rail = "─" * position + "━━" + "─" * max(0, travel - position - 1)
        lines += ["", red + rail + muted + f"  {int(elapsed):02d}s", muted + self.message[:width], "",
                  white + ("ONLINE" if self.online else "OFFLINE") + muted + "  ·  disposable workspace", muted + "Ctrl-C cancels and restores your theme"]
        output = []
        for index, line in enumerate(lines):
            if top + index >= rows:
                break
            output.append(f"\033[{top + index};{left}H\033[K{line}{reset}")
        emit("".join(output), passthrough=False)

    def finish(self):
        if self.finished:
            return
        self.finished = True
        self.halt.set()
        if self.thread:
            self.thread.join(timeout=2)
            emit("\033[?25h\033[?1049l", passthrough=False)

    def __exit__(self, *error):
        self.finish()


class KittyWallpaper:
    """Swap only this Kitty OS window; a transient GPU cover provides the fade."""

    def __init__(self):
        self.window = os.environ.get("KITTY_WINDOW_ID", "")
        self.binary = shutil.which("kitten")
        if not self.binary:
            candidate = Path("/Applications/kitty.app/Contents/MacOS/kitten")
            self.binary = str(candidate) if candidate.is_file() else None
        self.wallpaper = ROOT / "wallpaper.png"
        self.enabled = bool(self.binary and self.window.isdigit() and self.wallpaper.is_file() and sys.stdout.isatty())
        self.owner = False
        self.key = None
        self.geometry = None
        self.image = secrets.randbelow(2**31 - 1) + 1
        self.settings = preferences()
        self.duration = max(0, min(8, float(self.settings.get("fade_seconds", 2.4))))
        if os.environ.get("MRROBOT_NO_ANIMATION"):
            self.duration = 0

    def control(self, *arguments):
        environment = os.environ.copy()
        # Talk to the terminal that actually contains this shell. In particular,
        # do not inherit a stale socket address from a detached tmux server.
        environment.pop("KITTY_LISTEN_ON", None)
        # Kitty's terminal transport streams long control packets. A boot redraw
        # between writes can corrupt the image upload, so pause display output
        # until the command and its response have completed.
        with DISPLAY_LOCK:
            result = subprocess.run([self.binary, "@", "--use-password", "always", "--password", "", *arguments],
                                    capture_output=True, text=True, timeout=12, env=environment)
        if result.returncode:
            raise OSError(result.stderr.strip() or "Kitty background control is unavailable")
        return result.stdout

    @contextmanager
    def leases(self):
        with (ROOT / ".appearance.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            path = ROOT / "appearance.json"
            data = json.loads(path.read_text()) if path.exists() else {}
            data = {key: live for key, clients in data.items() if (live := [pid for pid in clients if alive(pid)])}
            try:
                yield data
            finally:
                if data:
                    path.write_text(json.dumps(data) + "\n")
                    path.chmod(0o600)
                else:
                    path.unlink(missing_ok=True)

    def cover(self, alpha):
        columns, rows = shutil.get_terminal_size((100, 30))
        try:
            _, _, pixel_width, pixel_height = struct.unpack("HHHH", fcntl.ioctl(sys.stdout.fileno(), termios.TIOCGWINSZ, b"\0" * 8))
        except (OSError, ValueError):
            pixel_width = pixel_height = 0
        pixel_width = pixel_width or columns * 10
        pixel_height = pixel_height or rows * 22
        if self.geometry:
            outer_columns, outer_rows = self.geometry
            pixel_width = round(pixel_width * outer_columns / columns)
            pixel_height = round(pixel_height * outer_rows / rows)
            columns, rows = outer_columns, outer_rows
        width, height = 128, max(1, round(128 * pixel_height / pixel_width))
        pixels = bytes((8, 6, 8, round(alpha))) * (width * height)
        payload = base64.b64encode(zlib.compress(pixels, 1)).decode()
        # Negative z keeps boot text above the cover. N=1 marks it transient.
        emit(f"\0337\033[H\033_Ga=T,f=32,o=z,s={width},v={height},c={columns},r={rows},C=1,z=-1,q=2,N=1,i={self.image},p=1;{payload}\033\\\0338")

    def fade(self, start, end, duration):
        if not duration:
            return
        begin = time.monotonic()
        while True:
            fraction = min(1, (time.monotonic() - begin) / duration)
            eased = fraction * fraction * (3 - 2 * fraction)
            self.cover(start + (end - start) * eased)
            if fraction == 1:
                break
            time.sleep(1 / 30)

    def clear_cover(self):
        emit(f"\033_Ga=d,d=I,i={self.image},q=2\033\\")

    def change(self, image, entering):
        try:
            self.fade(0, 255, min(0.45, self.duration / 4))
            self.control("set-background-image", "--match", "id:" + self.window, "--layout", "configured", str(image))
            self.fade(255, 0, self.duration if entering else min(1.1, self.duration))
        finally:
            self.clear_cover()

    def __enter__(self):
        if not self.enabled:
            return self
        try:
            listing = json.loads(self.control("ls", "--match", "id:" + self.window))
            if not listing:
                return self
            for tab in listing[0].get("tabs", []):
                for window in tab.get("windows", []):
                    if str(window["id"]) == self.window and window.get("columns") and window.get("lines"):
                        self.geometry = (window["columns"], window["lines"])
            self.key = str(os.environ.get("KITTY_PID", "")) + ":" + str(listing[0]["id"])
            with self.leases() as leases:
                clients = [p for p in leases.get(self.key, []) if alive(p)]
                self.owner = not clients
                leases[self.key] = clients + [os.getpid()]
                if self.owner:
                    self.change(self.wallpaper, entering=True)
        except (OSError, ValueError, KeyError, subprocess.SubprocessError):
            self.release()
            print("MRROBOT: wallpaper control unavailable; reload Kitty with Cmd+Shift+R.", file=sys.stderr)
        except BaseException:
            self.release()
            raise
        return self

    def release(self):
        if not self.key:
            return
        with self.leases() as leases:
            clients = [p for p in leases.get(self.key, []) if p != os.getpid() and alive(p)]
            if clients:
                leases[self.key] = clients
                self.key = None
                return
            leases.pop(self.key, None)
            # Index zero restores the configured wallpaper. With no configured
            # image, fall back to removing this session's background image.
            try:
                self.change("0", entering=False)
            except (OSError, subprocess.SubprocessError):
                try:
                    self.change("none", entering=False)
                except (OSError, subprocess.SubprocessError):
                    pass
            finally:
                self.key = None

    def __exit__(self, *error):
        self.release()


class LabError(Exception):
    pass


@contextmanager
def locked():
    if not ROOT.is_dir():
        raise LabError("MRROBOT is not installed. Run the setup script while online first.")
    with (ROOT / ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def save(state):
    temp = ROOT / ".state.tmp"
    temp.write_text(json.dumps(state, indent=2) + "\n")
    temp.chmod(0o600)
    os.replace(temp, STATE)


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def monitor(command):
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(3)
        connection.connect(str(RUN / "monitor.sock"))
        connection.sendall((command + "\n").encode())


def current():
    if not STATE.exists():
        return None
    state = json.loads(STATE.read_text())
    if not alive(state.get("pid")):
        return None
    try:
        monitor("info status")
    except OSError:
        return None
    state["clients"] = [p for p in state.get("clients", []) if alive(p)]
    return state


def cleanup():
    # Only the fixed runtime directory contains disposable overlays and logs.
    if RUN.is_symlink():
        raise LabError("Refusing to clean a symlink runtime directory")
    if RUN.exists():
        if not (RUN / ".mrrobot-session").is_file():
            raise LabError("Refusing to remove an unrecognized runtime directory")
        shutil.rmtree(RUN)
    STATE.unlink(missing_ok=True)


def stop_unlocked():
    state = current()
    if state:
        try:
            monitor("system_powerdown")
        except OSError:
            pass
        deadline = time.monotonic() + 20
        while alive(state["pid"]) and (RUN / "monitor.sock").exists() and time.monotonic() < deadline:
            time.sleep(0.25)
        if (RUN / "monitor.sock").exists():
            monitor("quit")
            deadline = time.monotonic() + 10
            while alive(state["pid"]) and time.monotonic() < deadline:
                time.sleep(0.1)
            if alive(state["pid"]):
                raise LabError("QEMU has not stopped yet; retry `mrrobot stop` before cleaning session files")
    cleanup()


def ssh_options(state):
    return ["-F", "/dev/null", "-i", str(ROOT / "identity"),
            "-o", "IdentitiesOnly=yes", "-o", "IdentityAgent=none",
            "-o", "ForwardAgent=no", "-o", "ClearAllForwardings=yes",
            "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=yes",
            "-o", "HostKeyAlias=mrrobot", "-o", f"UserKnownHostsFile={ROOT / 'known_hosts'}",
            "-o", "ConnectTimeout=3", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3"]


def ssh(state, command, tty=False, **kwargs):
    args = ["ssh", *ssh_options(state), "-p", str(state["port"])]
    if tty:
        args.append("-tt")
    args += ["ctf@127.0.0.1", command]
    return subprocess.run(args, **kwargs)


def start_unlocked(online=False, progress=None):
    state = current()
    if state:
        if online and not state["online"]:
            raise LabError("The current lab is offline. Export work and run `mrrobot stop` before starting with --online.")
        if progress:
            progress.update(6, "Joining your running workspace")
        return state
    if progress:
        progress.update(1, "Checking the prepared offline image")
    if not (ROOT / "system.qcow2").is_file() or not (ROOT / "ready.json").is_file():
        raise LabError("The offline system image is not ready. Complete setup first.")
    qemu = shutil.which("qemu-system-x86_64")
    image = shutil.which("qemu-img")
    if not qemu or not image:
        raise LabError("QEMU is required; install it before using the offline lab.")
    settings = preferences()
    memory, cpus = int(settings.get("memory_mb", 3072)), int(settings.get("cpus", 4))
    if not 1024 <= memory <= 16384 or not 1 <= cpus <= 16:
        raise LabError("Use 1024–16384 memory_mb and 1–16 cpus in settings.json")
    if progress:
        progress.update(2, "Creating the disposable disk overlay")
    cleanup()
    RUN.mkdir(mode=0o700)
    (RUN / ".mrrobot-session").write_text("disposable workspace\n")
    shutil.copy2(ROOT / "vars.fd", RUN / "vars.fd")
    subprocess.run([image, "create", "-q", "-f", "qcow2", "-F", "qcow2", "-b",
                    str(ROOT / "system.qcow2"), str(RUN / "session.qcow2")], check=True)
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        port = s.getsockname()[1]
    args = [qemu, "-name", "mrrobot", "-machine", "q35", "-accel", "tcg,thread=multi,tb-size=128",
            "-cpu", "max", "-smp", str(cpus), "-m", str(memory),
            "-drive", f"if=pflash,format=raw,readonly=on,file={ROOT}/firmware.fd",
            "-drive", f"if=pflash,format=raw,file={RUN}/vars.fd",
            "-drive", f"file={RUN}/session.qcow2,format=qcow2,if=virtio,discard=unmap",
            "-netdev", f"user,id=net0,restrict={'off' if online else 'on'},hostfwd=tcp:127.0.0.1:{port}-:22",
            "-device", "virtio-net-pci,netdev=net0", "-display", "none",
            "-serial", f"file:{RUN}/console.log", "-monitor", f"unix:{RUN}/monitor.sock,server=on,wait=off",
            "-pidfile", str(RUN / "qemu.pid"), "-daemonize"]
    result = subprocess.run(args, capture_output=True, text=True)
    if result.returncode:
        cleanup()
        raise LabError("Could not start QEMU: " + result.stderr.strip())
    state = {"pid": int((RUN / "qemu.pid").read_text()), "port": port, "online": online,
             "clients": [], "pending_entry": False}
    save(state)
    if progress:
        progress.update(3, f"Emulator online · {cpus} CPUs · {memory} MiB RAM")
    else:
        print("Booting MRROBOT / x86 Linux / " + ("online" if online else "offline") + "…", flush=True)
    try:
        deadline = time.monotonic() + 240
        while time.monotonic() < deadline:
            if progress:
                progress.console()
            result = ssh(state, "test -f /etc/mrrobot-ready", capture_output=True)
            if result.returncode == 0:
                if progress:
                    progress.update(6, "The analysis environment is ready")
                return state
            if not alive(state["pid"]):
                break
            time.sleep(1)
        raise LabError("The lab did not finish booting; inspect the runtime console log.")
    except BaseException:
        stop_unlocked()
        raise


@contextmanager
def activity(online=False, entry=False, require_running=False, progress=None):
    with locked():
        state = current()
        if require_running and not state:
            raise LabError("No active workspace. Start `mrrobot` or push a file first.")
        state = start_unlocked(online, progress)
        primed_here = False
        if entry:
            state["pending_entry"] = False
        elif not state["clients"] and not require_running:
            primed_here = not state["pending_entry"]
            state["pending_entry"] = True
        state["clients"].append(os.getpid())
        save(state)
    completed = False
    try:
        yield state
        completed = True
    finally:
        with locked():
            state = current()
            if state:
                if primed_here and not completed:
                    state["pending_entry"] = False
                state["clients"] = [p for p in state["clients"] if p != os.getpid() and alive(p)]
                save(state)
                if not state["clients"] and not state["pending_entry"]:
                    stop_unlocked()


def emit(sequence, passthrough=True):
    if passthrough and os.environ.get("TMUX"):
        sequence = "\033Ptmux;" + sequence.replace("\033", "\033\033") + "\033\\"
    with DISPLAY_LOCK:
        sys.stdout.write(sequence)
        sys.stdout.flush()


@contextmanager
def red_terminal():
    enabled = sys.stdout.isatty() and os.environ.get("TERM") != "dumb"
    if enabled:
        emit("\033[22;0t\033]2;MRROBOT / x86 CTF LAB\007")
        palette = ["#10070b", "#ff334f", "#d98592", "#ff9da7", "#e05575", "#c64f76", "#ff6b7f", "#f4cbd3",
                   "#75404d", "#ff6b7f", "#f4a4b1", "#ffd5dc", "#ff8c9d", "#ff9aba", "#ffc0cc", "#ffffff"]
        for index, color in enumerate(palette):
            emit(f"\033]4;{index};{color}\007")
        emit("\033]10;#f4cbd3\007\033]11;#10070b\007\033]12;#ffffff\007")
    try:
        yield
    finally:
        if enabled:
            emit("\033]104\007\033]110\007\033]111\007\033]112\007\033[23;0t\033[0m")


def endpoint(value, kind):
    if not value.startswith(kind + ":"):
        raise LabError(f"Expected {kind}:/path, got a different endpoint")
    path = value[len(kind) + 1:]
    if not path or any(c in path for c in "\n\r\x00"):
        raise LabError("Empty or invalid transfer path")
    if kind == "ctf":
        if not PurePosixPath(path).is_absolute() or ".." in PurePosixPath(path).parts:
            raise LabError("ctf: paths must be absolute and cannot contain ..")
        return path
    return str(Path(path).expanduser().resolve())


def transfer(args):
    push = args.command == "push"
    local = endpoint(args.source if push else args.destination, "mac")
    remote = endpoint(args.destination if push else args.source, "ctf")
    if push and not Path(local).exists():
        raise LabError("The local source does not exist")
    with activity(args.online, require_running=not push) as state:
        if push:
            directory = remote if remote.endswith("/") else str(PurePosixPath(remote).parent)
            result = ssh(state, "mkdir -p -- " + shlex.quote(directory))
            if result.returncode:
                raise LabError("Cannot create the guest destination; use a writable path such as /work/")
        else:
            Path(local).parent.mkdir(parents=True, exist_ok=True)
        cmd = ["scp", *ssh_options(state), "-P", str(state["port"])]
        if args.recursive or (push and Path(local).is_dir()):
            cmd.append("-r")
        guest = "ctf@127.0.0.1:" + remote
        cmd += ["--", local, guest] if push else ["--", guest, local]
        result = subprocess.run(cmd)
        if result.returncode:
            raise LabError("File transfer failed")
        print("Transferred. " + ("Run `mrrobot` to enter; `mrrobot stop` discards the temporary workspace." if push else "Saved to the Mac."))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--online", action="store_true", help="allow guest outbound network access for this session")
    sub = parser.add_subparsers(dest="command")
    for name in ("push", "pull"):
        p = sub.add_parser(name)
        p.add_argument("source")
        p.add_argument("destination")
        p.add_argument("-r", "--recursive", action="store_true")
    sub.add_parser("status")
    sub.add_parser("stop", help="discard the active temporary workspace")
    p = sub.add_parser("run", help="run a command in a disposable lab session")
    p.add_argument("args", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.command == "status":
        with locked():
            state = current()
            print("MRROBOT: " + (("running / online" if state["online"] else "running / offline") if state else "stopped"))
            if (ROOT / "system.qcow2").exists():
                size = sum(p.stat().st_blocks * 512 for p in ROOT.rglob("*") if p.is_file())
                print(f"Local installation: {size / 1024**3:.2f} GiB allocated")
        return 0
    if args.command == "stop":
        with locked():
            stop_unlocked()
        print("MRROBOT stopped; temporary session data removed.")
        return 0
    if args.command in ("push", "pull"):
        transfer(args)
        return 0
    if args.command == "run" and not args.args:
        raise LabError("Provide a guest command after `mrrobot run`")
    if args.command == "run":
        with activity(args.online, entry=True) as state:
            command = args.args[1:] if args.args[:1] == ["--"] else args.args
            if not command:
                raise LabError("Provide a guest command after `mrrobot run`")
            return ssh(state, "cd /work && exec " + shlex.join(command)).returncode
    with red_terminal():
        with BootScreen(args.online) as boot:
            with KittyWallpaper():
                with activity(args.online, entry=True, progress=boot) as state:
                    boot.finish()
                    mode = "online" if state["online"] else "offline"
                    return ssh(state, f"cd /work && export MRROBOT_NETWORK={mode} && exec bash -l", tty=True).returncode


if __name__ == "__main__":
    def interrupted(signum, frame):
        raise KeyboardInterrupt

    # Closing a terminal should unwind the session and remove its overlay too.
    for event in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(event, interrupted)
    try:
        sys.exit(main())
    except (LabError, OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"mrrobot: {error}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
